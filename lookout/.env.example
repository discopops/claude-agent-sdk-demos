# Lookout configuration — copy to .env and fill in.

# Auth — two modes:
# 1) SUBSCRIPTION (default): leave ANTHROPIC_API_KEY unset. The Agent SDK spawns
#    the Claude Code binary, which uses its own login (run `claude` once and
#    /login with your Claude subscription). No metered API spend.
# 2) METERED API: set the key and interpretation bills to the Anthropic API.
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for the interpretation engine (cheap by default).
LOOKOUT_MODEL=claude-haiku-4-5-20251001

# --- Data sources ---------------------------------------------------------
# Kalshi public read endpoints need NO auth and are LIVE by default.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# X is OFF by default (no free tier — without credentials it could only run on
# invented fixtures). It registers when configured live, or with the mock flag
# for fixture demos.
# X_MCP_URL=https://api.x.com/mcp
# X_MCP_BEARER=
# LOOKOUT_ENABLE_X_MOCK=1    # fixture-demo mode only — fabricated chatter

# GROK VOICES — live X chatter via xAI's Grok (the only frontier model with
# native X grounding), through the Agent Tools API (x_search). NOT a poll
# source: fires only inside the deep pass / "dig in", billed per tool
# invocation + tokens, with a hard daily gather cap. OFF by default.
# LOOKOUT_ENABLE_GROK_VOICES=1
# XAI_API_KEY=xai-...
# LOOKOUT_GROK_MODEL=grok-4.3
# LOOKOUT_GROK_GATHERS_PER_DAY=20    # hard daily budget (billed per tool invocation + tokens)

# Google Trends is LIVE by default via the public trending-now RSS (no key),
# fetched per profile region, cached 10 min. Off-lens trends cluster into one
# "zeitgeist" situation. Falls back to fixtures on failure.
# LOOKOUT_TRENDS_MODE=mock   # force fixtures
# LOOKOUT_TRENDS_RSS=https://trends.google.com/trending/rss

# GDELT (free, global news-event coverage) is a follow-on source and OPT-IN —
# the default build stays interpretation-first: fewer sources, deeper reasoning.
# LOOKOUT_ENABLE_GDELT=1
# GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc

# Path to the Claude Code executable the Agent SDK spawns for interpretation.
# Set this when running outside the environment Lookout was built in
# (e.g. macOS Homebrew: /opt/homebrew/bin/claude).
# LOOKOUT_CLAUDE_BIN=/opt/homebrew/bin/claude

# Fan out earned interrupts + briefs to your own relay (Slack/Discord/push/SMS).
# Receives POST JSON {kind,title,text,ts}. Console notifications are always on.
# LOOKOUT_NOTIFY_WEBHOOK=https://hooks.example.com/lookout

# --- Loop tuning ----------------------------------------------------------
LOOKOUT_TICK_SECONDS=60

# Spoken briefings at local times (comma-separated HH:MM), once per day each.
# Leave unset to disable timed briefs (the "▶ brief me" button still works).
# LOOKOUT_BRIEF_TIMES=08:00,17:00

# Auto-escalate the deep multi-agent pass on interrupt-level salience or a
# standing-question hit. Set 0 to disable; cap per tick with MAX_AUTODEEP.
# LOOKOUT_AUTO_DEEP=1
# LOOKOUT_MAX_AUTODEEP=1

# Use an LLM relevance triage instead of keyword overlap for the personalization
# gate (sharper, but one cheap model call per candidate situation per tick).
# LOOKOUT_LLM_RELEVANCE=1
