# Lookout configuration — copy to .env and fill in.

# Required: the Anthropic API key the Agent SDK uses for interpretation.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the interpretation engine (cheap by default).
LOOKOUT_MODEL=claude-haiku-4-5-20251001

# --- Data sources ---------------------------------------------------------
# Kalshi public read endpoints need NO auth and are LIVE by default.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# X is MCP-ready but runs on MOCK fixtures by default (no free tier + OAuth
# can't complete in a non-interactive environment). Leave unset to stay mock.
# X_MCP_URL=https://api.x.com/mcp
# X_MCP_BEARER=

# Google Trends has no official API; best-effort live with mock fallback.
# LOOKOUT_TRENDS_MODE=mock   # mock | live

# --- Loop tuning ----------------------------------------------------------
LOOKOUT_TICK_SECONDS=60
