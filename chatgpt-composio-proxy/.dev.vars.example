# Copy this to .dev.vars for local development with `wrangler dev`
# .dev.vars is gitignored — never commit real values.

# Full MCP URL for your Composio tool router session
COMPOSIO_MCP_URL=https://backend.composio.dev/tool_router/trs_YOUR_SESSION_ID/mcp

# Your Composio API key (x-api-key header)
COMPOSIO_API_KEY=ak_your_key_here
