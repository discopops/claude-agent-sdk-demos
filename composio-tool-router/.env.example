# Composio API key — get yours at https://app.composio.dev/settings
COMPOSIO_API_KEY=your_composio_api_key_here

# A stable identifier for the user whose connections the agent will use.
# Can be any string (e.g. email, UUID).  Defaults to "default-user" if omitted.
COMPOSIO_USER_ID=your_user_id_here

# Anthropic API key — used internally by the Claude Agent SDK
ANTHROPIC_API_KEY=your_anthropic_api_key_here
